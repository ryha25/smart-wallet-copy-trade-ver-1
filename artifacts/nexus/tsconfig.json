{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/App.tsx",
    "src/main.tsx",
    "src/components/trading-app.tsx",
    "src/components/login-gate.tsx",
    "src/lib/default-settings.ts",
    "src/lib/live-types.ts",
    "src/lib/paper-trading.ts",
    "src/lib/types.ts",
    "src/index.css",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
