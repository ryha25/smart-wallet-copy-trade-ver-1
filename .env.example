DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_wallet?schema=public"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
HELIUS_API_KEY=""
BIRDEYE_API_KEY=""
JUPITER_API_KEY=""
MORALIS_API_KEY=""
ALCHEMY_API_KEY=""
# Alchemy以外のRPCを使う場合のみ設定（ALCHEMY_API_KEYより優先）
ETHEREUM_RPC_URL=""
# カンマ区切り。未設定時は実在する主要5トークンを使用
EVM_ETH_DISCOVERY_TOKENS=""
EVM_SCAN_ANALYSIS_LIMIT="40"
EVM_SCAN_AUTO_REFRESH_HOURS="6"
APP_USERNAME=""
APP_PASSCODE=""
SESSION_SECRET=""
DEBUG_ERRORS="false"
WALLET_SCAN_DISCOVERY_PER_DEX="300"
WALLET_SCAN_ANALYSIS_LIMIT="250"
WALLET_SCAN_HISTORY_PAGES="3"
WALLET_SCAN_CONCURRENCY="5"
WALLET_SCAN_AUTO_REFRESH_HOURS="6"
WALLET_SCAN_CACHE_MAX_AGE_HOURS="168"
COPY_MONITOR_INTERVAL_SECONDS="15"
# 保有ポジションの損切り・利確監視。DEX Screenerの30銘柄一括APIを使います。
POSITION_MONITOR_INTERVAL_MS="1000"
# 手動・自動・お気に入り経由を合算したコピー元ウォレット上限
COPY_SOURCE_WALLET_LIMIT="30"
NEXT_PUBLIC_COPY_SOURCE_WALLET_LIMIT="30"
# 実売買は専用の少額ウォレットだけを使用。初期値falseのままペーパーで確認してください。
LIVE_TRADING_ENABLED="false"
TRADING_WALLET_PUBLIC_KEY=""
# Base58秘密鍵、またはSolana CLI keypairの64整数JSON配列。DB・Git・画面へ保存しません。
TRADING_WALLET_SECRET_KEY=""
